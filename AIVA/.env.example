# Copy to .env and edit for this computer. launch.sh and setup.sh load AIVA/.env.
# Keep credentials, machine-specific paths, and model locations out of Git.

# ROS 2 and Python workspace
ROS_SETUP=/opt/ros/jazzy/setup.bash
AIVA_PYTHON=python3
AIVA_VENV=
AGI_BRANCH=dev
AGI_HOME=${HOME}/.agi
AIVA_START_CHAT=1

# Local llama.cpp router. Set LLAMA_CPP_DIR to the llama.cpp checkout.
LLAMA_CPP_DIR=${HOME}/llama.cpp
LLAMA_SERVER_BIN=
LLAMA_ROUTER_INI=
AIVA_LLM_PORT=8080
AIVA_LLM_BASE_URL=
AIVA_EMBED_BASE_URL=
AIVA_LLM_MODEL=ministral-3-8b-uncensored
AIVA_DRAW_MODEL=swift15-qwen3.8-27b
AIVA_DRAW_REASONING_EFFORT=medium
AIVA_LLM_API_KEY=

# Local console and ROS bridge. Console listens on loopback by default.
TELEPATHIC_CONSOLE_HOST=127.0.0.1
TELEPATHIC_CONSOLE_PORTAL=8853
TELEPATHIC_GATEWAY=
AGI_ROSBRIDGE_URL=ws://127.0.0.1:9090
AGI_SOURCE_ID=
AGI_TELEPATHIC_CHANNEL=grace
AGI_TELEPATHIC_SCHEME=ternary_utf8_v1
AGI_WEB_TELEOPS_CONSOLE_PRESENCE_URL=
AGI_PRESENCE_INTERVAL=4
AGI_AIVA_PRESENCE_TIMEOUT=12

# Memory, logs, and conversation
AIVA_MEMORY_PATH=
AIVA_TIMEZONE=America/Vancouver
AIVA_LOG_DIR=

# Canvas and painting options
AGI_CANVAS_API_KEY=
AGI_CANVAS_ASSISTANT_NAME=Grace
AGI_CANVAS_REFERENCE_MODE=1
AGI_CANVAS_IMAGE_MODE=1
AGI_CANVAS_FEEDBACK=1
AGI_CANVAS_INPUT_TOPIC=/telepathic/stimulus
AGI_CANVAS_RESPONSE_TOPIC=/telepathic/response
AGI_CANVAS_SNAPSHOT_TOPIC=/aiva/canvas_snapshot
MOSS_PAINT=1
MOSS_PAINT_SERVER_BIN=
MOSS_PAINT_WEIGHTS_ROOT=
MOSS_PAINT_MODEL_DIR=
MOSS_PAINT_DIT_FILE=
MOSS_PAINT_TE_FILE=
MOSS_PAINT_VAE_FILE=
MOSS_PAINT_DISTILL_DIR=
MOSS_PAINT_DEVICE=1
MOSS_PAINT_VRAM_MIB=4096
MOSS_PAINT_TIMEOUT_SECONDS=300
MOSS_PAINT_RELEASE=1
AIVA_DRAW_MAX_TOKENS=6144
AIVA_DRAW_TIMEOUT_SECONDS=600
AIVA_DRAW_MAX_SECONDS=240
AIVA_SNAPSHOT_TIMEOUT_SECONDS=10
