# Copy to .env and edit non-secret runtime overrides for this computer.
# launch.sh and setup.sh load AIVA/.env. Keep credentials out of this file.

# ROS 2 and Python workspace
ROS_SETUP=
AIVA_PYTHON=
AIVA_VENV=
AGI_BRANCH=
AGI_HOME=
AIVA_START_CHAT=

# Local llama.cpp router. Set LLAMA_CPP_DIR to the llama.cpp checkout.
LLAMA_CPP_DIR=
LLAMA_SERVER_BIN=
LLAMA_ROUTER_INI=
AIVA_LLM_PORT=
AIVA_LLM_BASE_URL=
AIVA_EMBED_BASE_URL=
AIVA_LLM_MODEL=
AIVA_DRAW_MODEL=
AIVA_DRAW_REASONING_EFFORT=

# Local console and ROS bridge. Console listens on loopback by default.
TELEPATHIC_CONSOLE_HOST=
TELEPATHIC_CONSOLE_PORTAL=
TELEPATHIC_GATEWAY=
AGI_ROSBRIDGE_URL=
AGI_SOURCE_ID=
AGI_TELEPATHIC_CHANNEL=
AGI_TELEPATHIC_SCHEME=
AGI_WEB_TELEOPS_CONSOLE_PRESENCE_URL=
AGI_PRESENCE_INTERVAL=
AGI_AIVA_PRESENCE_TIMEOUT=

# Memory, logs, and conversation
AIVA_MEMORY_PATH=
AIVA_TIMEZONE=
AIVA_LOG_DIR=

# Canvas and painting options
AGI_CANVAS_ASSISTANT_NAME=
AGI_CANVAS_REFERENCE_MODE=
AGI_CANVAS_IMAGE_MODE=
AGI_CANVAS_FEEDBACK=
AGI_CANVAS_INPUT_TOPIC=
AGI_CANVAS_RESPONSE_TOPIC=
AGI_CANVAS_SNAPSHOT_TOPIC=
MOSS_PAINT=
MOSS_PAINT_SERVER_BIN=
MOSS_PAINT_WEIGHTS_ROOT=
MOSS_PAINT_MODEL_DIR=
MOSS_PAINT_DIT_FILE=
MOSS_PAINT_TE_FILE=
MOSS_PAINT_VAE_FILE=
MOSS_PAINT_DISTILL_DIR=
MOSS_PAINT_DEVICE=
MOSS_PAINT_VRAM_MIB=
MOSS_PAINT_TIMEOUT_SECONDS=
MOSS_PAINT_RELEASE=
AIVA_DRAW_MAX_TOKENS=
AIVA_DRAW_TIMEOUT_SECONDS=
AIVA_DRAW_MAX_SECONDS=
AIVA_SNAPSHOT_TIMEOUT_SECONDS=
